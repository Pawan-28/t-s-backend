# ---------------------------------------------------------------------------
# Truth & Social - Laravel API. Placeholders only. NEVER commit a real .env.
# ---------------------------------------------------------------------------
APP_NAME="Truth & Social API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Next.js frontend origin(s), comma separated (CORS allow-list)
FRONTEND_URL=https://www.example.com
CORS_ALLOWED_ORIGINS=https://www.example.com

# Trust X-Forwarded-* only from your own reverse proxy (Nginx on the same host on a VPS).
# Comma separated IPs/CIDRs, or * only if the API is unreachable except via the proxy.
# Shared hosting where PHP sees the real visitor address (no proxy/CDN in front): keep 127.0.0.1.
# Wrong values make every visitor share one IP for rate limiting (see docs/HOSTINGER_DEPLOYMENT.md).
TRUSTED_PROXIES=127.0.0.1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---- MySQL / MariaDB (NEW Laravel database; never the Django one) ---------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=truthsocial
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password
# Optional numeric session offset (default: derived from APP_TIMEZONE). Do NOT use a zone name on shared hosting.
# DB_TIMEZONE=+05:30

# READ-ONLY access to the OLD Django database, importer only (leave blank otherwise)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=
LEGACY_DB_USERNAME=
LEGACY_DB_PASSWORD=

# ---- Runtime drivers: pick ONE profile (see docs/HOSTINGER_DEPLOYMENT.md) -------------------------
# Every value below is chosen only here. With PROFILE A no Redis server and no phpredis extension are needed,
# and no long-running process (no queue daemon, no schedule:work). Verify with: php artisan portal:doctor
#
# PROFILE A - shared hosting (Hostinger Business etc.: MySQL + cron, no Redis, no daemons)  <- default
CACHE_STORE=database
QUEUE_CONNECTION=database
ANALYTICS_DRIVER=database
# The scheduler drains the queue itself every minute (needs only the single cron entry
# `* * * * * cd /path/to/backend-laravel && php artisan schedule:run >> /dev/null 2>&1`).
QUEUE_VIA_SCHEDULER=true
#
# PROFILE B - VPS with Redis and a supervisor-managed `php artisan queue:work redis` daemon
# (comment out the PROFILE A lines above and uncomment these):
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# ANALYTICS_DRIVER=redis
# QUEUE_VIA_SCHEDULER=false
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=null
# REDIS_DB=0
# REDIS_CACHE_DB=1
# REDIS_ANALYTICS_DB=2
#
# Optional: keep rate-limit counters in another store than CACHE_STORE (database | file | redis).
# CACHE_LIMITER_STORE=
# When switching ANALYTICS_DRIVER from redis to database, first run `php artisan analytics:flush --redis`.
CACHE_PREFIX=truthsocial-cache-
SESSION_DRIVER=array

# ---- Auth ------------------------------------------------------------------
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7

# ---- Bunny.net Storage -------------------------------------------------------
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=
BUNNY_PULL_ZONE_URL=
MAX_IMAGE_UPLOAD_SIZE_MB=5
IMAGE_MAX_DIMENSION_PX=2000

# ---- Razorpay (one-time payments) ---------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- WATI (WhatsApp sender) -----------------------------------------------------
WATI_API_ENDPOINT=
WATI_ACCESS_TOKEN=
WATI_OTP_TEMPLATE_NAME=
WATI_SUBSCRIPTION_ACTIVATED_TEMPLATE_NAME=
WATI_PAYMENT_FAILED_TEMPLATE_NAME=
WATI_SUBSCRIPTION_EXPIRING_TEMPLATE_NAME=
WATI_SUBSCRIPTION_EXPIRED_TEMPLATE_NAME=
WATI_ARTICLE_PUBLISHED_TEMPLATE_NAME=

# ---- OpenAI (only AI provider) ------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Copyleaks ----------------------------------------------------------------------
COPYLEAKS_EMAIL=
PLAGIARISM_API_KEY=
COPYLEAKS_WEBHOOK_BASE_URL=https://api.example.com
COPYLEAKS_WEBHOOK_SECRET=
COPYLEAKS_SANDBOX_MODE=true

# ---- Mail ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# ---- Analytics ---------------------------------------------------------------------------
ANALYTICS_VIEW_COOLDOWN_SECONDS=30
# (ANALYTICS_DRIVER is chosen in the runtime-driver profile above.)

# ---- Optional rate-limit overrides (default = Django values), e.g. "20/minute"
# THROTTLE_AUTH_LOGIN_IP_RATE=
# THROTTLE_ANON_RATE=
